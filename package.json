{
  "name": "gitroll",
  "version": "0.3.0",
  "description": "A private logbook that lives in your own Git repository. Log what happened, find it later.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "gitroll": "dist/gitroll.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/build.mjs",
    "gitroll": "node --disable-warning=ExperimentalWarning src/node/cli.ts",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.ts\"",
    "typecheck": "tsc",
    "build:core": "tsc -p packages/core/tsconfig.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.13.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.15",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.46.0",
    "marked": "^18.0.13",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  },
  "files": [
    "dist",
    "template",
    "README.md",
    "docs/CLI.md",
    "SPEC.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "keywords": [
    "logbook",
    "journal",
    "git",
    "local-first",
    "privacy"
  ],
  "author": "Jimmy Ho",
  "homepage": "https://github.com/jimhoyd-com/gitroll#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jimhoyd-com/gitroll.git"
  },
  "bugs": {
    "url": "https://github.com/jimhoyd-com/gitroll/issues"
  }
}
